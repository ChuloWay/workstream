  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "Canonical machine-readable API error.",
        "properties": {
          "code": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "correlation_id",
          "retryable"
        ],
        "type": "object"
      },
      "ApiErrorResponse": {
        "additionalProperties": false,
        "description": "Canonical error plus additive legacy compatibility fields.",
        "properties": {
          "detail": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GuideActivationCondition": {
        "additionalProperties": false,
        "description": "One unmet precondition with the refusal code activation would raise for it.",
        "properties": {
          "code": {
            "enum": [
              "proposal_unavailable",
              "proposal_stale",
              "approval_blocked"
            ],
            "type": "string"
          },
          "message": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "missing_capabilities": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/MissingCheckerCapability"
            },
            "maxItems": 200,
            "type": "array"
          },
          "reason": {
            "enum": [
              "project_not_activatable",
              "post_policy_unavailable",
              "upstream_approval_not_current",
              "post_policy_not_approved",
              "guide_not_draft",
              "review_policy_unselected",
              "revision_policy_unselected",
              "source_snapshot_invalid",
              "checker_policy_unsupported",
              "checker_policy_mismatch",
              "checker_registry_changed",
              "checker_capability_missing",
              "human_review_required_by_guide",
              "activation_requirements_unmet",
              "contribution_policy_unpublished",
              "contribution_policy_invalid",
              "activation_integrity_failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ],
        "type": "object"
      },
      "GuideActivationReadiness": {
        "additionalProperties": false,
        "description": "Dry-run result over the current selections; not a promise that activation will succeed later.\n\n``unmet`` is in activation's check order, so its first entry carries the\nrefusal code activation would raise now. A check whose inputs are missing\nis not evaluated.",
        "properties": {
          "guide_id": {
            "format": "uuid",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "unmet": {
            "items": {
              "$ref": "#/components/schemas/GuideActivationCondition"
            },
            "type": "array"
          }
        },
        "required": [
          "project_id",
          "guide_id",
          "ready",
          "unmet"
        ],
        "type": "object"
      },
      "MissingCheckerCapability": {
        "additionalProperties": false,
        "description": "Bounded manager feedback from the approved compilation's missing checks.",
        "properties": {
          "requirement_id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
            "type": "string"
          },
          "stage": {
            "enum": [
              "pre_submit",
              "post_submit"
            ],
            "type": "string"
          },
          "title": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "stage",
          "title"
        ],
        "type": "object"
      }
    }
  },
