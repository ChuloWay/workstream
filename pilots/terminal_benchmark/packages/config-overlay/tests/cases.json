[
  {
    "name": "nested-preservation",
    "steps": [
      {
        "input": {
          "base": {
            "db": {
              "host": "localhost",
              "port": 12
            },
            "keep": null
          },
          "overrides": {
            "db": {
              "port": 34
            }
          }
        },
        "expected": {
          "config": {
            "db": {
              "host": "localhost",
              "port": 34
            },
            "keep": null
          }
        }
      }
    ]
  },
  {
    "name": "delete-and-falsy",
    "steps": [
      {
        "input": {
          "base": {
            "remove": 1,
            "flag": true,
            "count": 8,
            "name": "old"
          },
          "overrides": {
            "remove": null,
            "flag": false,
            "count": 0,
            "name": "",
            "missing": null
          }
        },
        "expected": {
          "config": {
            "flag": false,
            "count": 0,
            "name": ""
          }
        }
      }
    ]
  },
  {
    "name": "arrays-replace",
    "steps": [
      {
        "input": {
          "base": {
            "list": [
              1,
              2,
              3
            ]
          },
          "overrides": {
            "list": []
          }
        },
        "expected": {
          "config": {
            "list": []
          }
        }
      }
    ]
  },
  {
    "name": "object-replaces-scalar",
    "steps": [
      {
        "input": {
          "base": {
            "value": 7
          },
          "overrides": {
            "value": {
              "gone": null,
              "kept": 2
            }
          }
        },
        "expected": {
          "config": {
            "value": {
              "kept": 2
            }
          }
        }
      }
    ]
  },
  {
    "name": "empty",
    "steps": [
      {
        "input": {
          "base": {},
          "overrides": {}
        },
        "expected": {
          "config": {}
        }
      }
    ]
  }
]
